# Core
COMPOSE_PROJECT_NAME=ecopollen-starter
APP_DOMAIN=localhost

# Ports
FRONTEND_PORT=80
DEV_FRONTEND_PORT=5173
DEV_BACKEND_PORT=8000
DEV_POSTGRES_PORT=5432

# Database
POSTGRES_DB=ecopollen
POSTGRES_USER=ecopollen
POSTGRES_PASSWORD=change_me_db_password

# Backend
JWT_SECRET=change_me_jwt_secret
DEFAULT_ADMIN_EMAIL=admin@example.local
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
CROSSREF_CONTACT_EMAIL=admin@example.local

# Imports
POLLEN_IMPORTS_ENABLED=true
POLLEN_IMPORT_ON_STARTUP=true
POLLEN_IMPORT_HOUR_UTC=08
POLLEN_IMPORT_MINUTE_UTC=00
OPEN_METEO_IMPORT_BATCH_DELAY_SECONDS=10
